{
  "name": "@ireves/common-api",
  "version": "1.4.11",
  "description": "Simple Backend framework with JWT and MySQL support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rimraf dist/ && tsc",
    "dev": "nodemon --watch \"./src/**/*.ts\" --exec \"tsx\" ./src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VriskaSerket51/common-api.git"
  },
  "keywords": [
    "api",
    "backend",
    "express",
    "nodejs",
    "javascript",
    "typescript"
  ],
  "author": "VriskaSerket51",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/VriskaSerket51/common-api/issues"
  },
  "homepage": "https://github.com/VriskaSerket51/common-api#readme",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "@types/node-schedule": "^2.1.8",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "node-schedule": "^2.1.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
