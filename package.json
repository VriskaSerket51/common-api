{
  "name": "@ireves/common-api",
  "version": "2.0.0",
  "description": "ESM backend framework with JWT, scheduling and typed database injection.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc",
    "dev": "tsx watch --include \"./src/**/*.ts\" ./src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test",
    "test:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VriskaSerket51/common-api.git"
  },
  "keywords": [
    "api",
    "backend",
    "express",
    "nodejs",
    "javascript",
    "typescript"
  ],
  "author": "VriskaSerket51",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/VriskaSerket51/common-api/issues"
  },
  "homepage": "https://github.com/VriskaSerket51/common-api#readme",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ]
}
